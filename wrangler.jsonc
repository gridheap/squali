  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "limits": {"cpu_ms":1000},
  "vars": {"MAX_PROJECTS":"10","MONTHLY_ARTIFACT_CALL_CAP":"2000","ADOBE_KIT_ID":"ggy5hcn"},
  "observability": {"enabled":false}
}
