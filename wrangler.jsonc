{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gridheap-weave",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"squa.li","custom_domain":true,"zone_id":"a9e767db975bf6b80cfdad9df81e972b","previews_enabled":false}],
  "account_id": "52f8a24263418828b635c91b6eb06a83",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {"region":"azure:eastus2"},
  "r2_buckets": [{"binding":"OBJECTS","bucket_name":"squali-objects"}],
  "artifacts": [{"binding":"ARTIFACTS","namespace":"weave"}],
  "hyperdrive": [{"binding":"HYPERDRIVE","id":"c5366ae0d2d54d76b2b7daf414c6333d"}],
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "limits": {"cpu_ms":30000},
  "vars": {"MAX_PROJECTS":"10","MONTHLY_ARTIFACT_CALL_CAP":"2000","MONTHLY_R2_READ_CAP":"20000","MONTHLY_R2_WRITE_CAP":"2000","ADOBE_KIT_ID":"ggy5hcn"},
  "observability": {"enabled":false}
}
