{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gridheap-weave",
  "account_id": "52f8a24263418828b635c91b6eb06a83",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
